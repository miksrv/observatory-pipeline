# ============================================================
# Observatory Pipeline — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# API — Remote observatory-api (required)
# ------------------------------------------------------------
API_BASE_URL=https://your-cloud-host.com/api/v1
API_KEY=your-secret-api-key-here

# ------------------------------------------------------------
# FITS directory paths (inside the Docker container)
# These must match the volume mounts in docker-compose.yml
# ------------------------------------------------------------
FITS_INCOMING=/fits/incoming
FITS_ARCHIVE=/fits/archive
FITS_REJECTED=/fits/rejected
FITS_RAW_ARCHIVE=/fits/raw

# ------------------------------------------------------------
# ASTAP plate solver
# ------------------------------------------------------------
ASTAP_BINARY=/usr/local/bin/astap
ASTAP_CATALOGS=/astap/catalogs

# Optional field-of-view hint in degrees for faster plate solving.
# Set to 0 (default) for auto-detection from FITS headers.
# Providing an approximate FOV speeds up plate solving significantly.
ASTAP_FOV_HINT=0

# When the narrow, header-based search finds no match, retry once with a
# wide/effectively-blind search radius before giving up — covers a mount
# pointing error large enough to put the true position outside the narrow
# window, while the frame itself is perfectly solvable.
ASTAP_RETRY_WIDE_SEARCH=true
# Search radius (degrees) for that retry.
ASTAP_WIDE_SEARCH_RADIUS_DEG=30

# Subprocess timeout (seconds) for the ordinary narrow search attempt.
ASTAP_TIMEOUT_SEC=60
# Subprocess timeout (seconds) for the wide/blind retry attempt — kept
# separate and larger than ASTAP_TIMEOUT_SEC: a blind search over tens of
# degrees against the full star catalog is far more expensive than a
# narrow, header-guided one. Time a manual astap run at
# ASTAP_WIDE_SEARCH_RADIUS_DEG on your own hardware before tuning this down.
ASTAP_WIDE_SEARCH_TIMEOUT_SEC=240

# ------------------------------------------------------------
# Quality control thresholds
# Tune these values for your telescope and local seeing.
# ------------------------------------------------------------

# Maximum acceptable median FWHM in arcseconds (focus quality)
QC_FWHM_MAX_ARCSEC=8.0

# Maximum acceptable PSF elongation ratio (tracking quality)
# 1.0 = perfectly round stars; >2.0 indicates trailing
QC_ELONGATION_MAX=2.0

# Minimum acceptable median SNR of detected sources
QC_SNR_MIN=5.0

# Minimum number of detected stars required to accept a frame
QC_STARS_MIN=10

# Same as QC_STARS_MIN, but applied instead of it when the frame's own filter
# is narrowband (see NARROWBAND_FILTERS below) — a narrowband frame of the
# same field genuinely detects far fewer stars than a broadband one, so
# QC_STARS_MIN alone would reject good narrowband data as LOW_STARS.
QC_STARS_MIN_NARROWBAND=5

# Maximum acceptable median sky background in ADU (twilight/moonlight/cloud/
# stray light). Tune to your own site's typical dark-sky background.
QC_SKY_BACKGROUND_MAX=20000.0

# Emission-line filters (normalized short codes) too narrow to carry a
# representative star sample or a trustworthy Gaia DR3 zero-point. Frames
# shot in one of these use QC_STARS_MIN_NARROWBAND instead of QC_STARS_MIN,
# and modules/photometry.py never attempts magnitude calibration on them.
NARROWBAND_FILTERS=Ha,OIII,SII,NII,LeNhance,LeXtreme,LuLtimate,NBZ,QuadBand,TriBand,DuoBand

# ------------------------------------------------------------
# Star detection filtering
# These parameters filter raw source detections to keep only
# point sources (stars) and reject extended objects (nebulae,
# galaxy parts) and artifacts (hot pixels, cosmic rays).
# ------------------------------------------------------------

# SEP source extraction thresholds
# Higher values = fewer detections (more conservative)
SEP_DETECT_THRESH=10.0
SEP_MIN_AREA=15

# FWHM range — sources outside this range are rejected
# Min, in PIXELS: below this = hot pixel or cosmic ray (too sharp); a pixel-grid
#   property, independent of the optics (1.2 px is just above a lit 2x2 block)
# Max, in arcseconds: above this = extended object or badly defocused star
STAR_FWHM_MIN_PX=1.2
STAR_FWHM_MAX_ARCSEC=8.0

# Maximum elongation — above this is a trail or extended object
# Stars should be close to 1.0 (round)
STAR_ELONGATION_MAX=1.5

# Maximum elongation for the LOOSE "sources_all" list that catalog matching
# and anomaly detection run on. Far above STAR_ELONGATION_MAX on purpose: a
# trailed detection is exactly what anomaly_detector needs in order to
# classify SPACE_DEBRIS. Must stay comfortably ABOVE
# SPACE_DEBRIS_EDGE_ELONGATION_MIN, or a trailed near-edge source is cut
# before the classifier can ever see it.
SOURCES_ALL_ELONGATION_MAX=15.0

# Minimum SNR (peak/rms) — below this is likely noise
# Higher = fewer but more reliable detections
STAR_SNR_MIN=50.0

# ------------------------------------------------------------
# Streak masking (astrometry + qc + subtraction modules)
# A coarse, low-threshold, non-deblended pre-pass that finds long thin
# streaks — satellite/aircraft trails and bright-star diffraction-spike
# arms — and masks their pixels out BEFORE the real point-source
# extraction/diff-image detection runs, so they cannot fragment into
# spurious point-like "stars" (or, on the subtraction diff image, into
# dozens of separate SPACE_DEBRIS-eligible candidates for one real trail).
# See CLAUDE.md's modules/astrometry.py section for the real-data
# verification (2026-08-07, T_CrB test frames).
# ------------------------------------------------------------

# Coarse pass's own detection threshold (sigma above background). Kept
# LOWER than SEP_DETECT_THRESH/SUBTRACTION_DETECT_SIGMA on purpose: a faint
# trail's brightness can dip below a higher threshold often enough to still
# fragment into many short pieces too small to individually clear
# STREAK_MIN_LENGTH_ARCSEC below.
STREAK_DETECT_SIGMA=3.0

# A coarse candidate is treated as a streak only when BOTH conditions hold:
# elongation >= STREAK_ELONGATION_MIN AND bounding-box diagonal >=
# STREAK_MIN_LENGTH_ARCSEC. An ordinary star (even a deblended close pair)
# never reaches this combination.
STREAK_ELONGATION_MIN=5.0
STREAK_MIN_LENGTH_ARCSEC=30.0

# Small dilation (arcsec) applied to the coarse streak mask before use, so
# the segmentation boundary doesn't leave a thin rim of trail pixels just
# outside the mask still detectable as their own tiny fragment.
STREAK_MASK_DILATE_ARCSEC=3.0

# ------------------------------------------------------------
# Saturation detection (astrometry + subtraction modules)
# ------------------------------------------------------------

# Sensor pixel value (ADU) at/above which a pixel is considered saturated.
# Default assumes a 16-bit sensor with headroom below the hard 65535
# ceiling for non-linearity near full well — tune per camera.
SATURATION_ADU=60000

# Radius (arcsec) around a saturated pixel that subtraction.py excludes
# from difference-image source detection, to suppress astroalign residual
# artifacts around bright/saturated stars (see docs/ISSUES.md #1, #2).
SATURATION_MASK_RADIUS_ARCSEC=10.0

# ------------------------------------------------------------
# Catalog cross-matching
# ------------------------------------------------------------

# Cone search radius (arcsec) for point-source catalog matching
MATCH_CONE_ARCSEC=5.0

# How many times a frame may be re-queued when the API retry is exhausted and
# its sources/anomalies could not be posted. The frame record itself survives
# such an outage — what is lost is that run's science payload — so the work is
# put back on the task queue. This bounds it: a transient outage clears within
# one attempt, while a permanent failure would otherwise re-queue forever.
# 0 disables recovery entirely.
API_RECOVERY_MAX_ATTEMPTS=2

# Plate scale (arcsec/px) a solved WCS must fall between to be believed. A
# solution outside this window is not marginal, it is wrong: below the floor
# no amateur telescope resolves, above the ceiling the frame would not be an
# image of a star field. Widen for an unusual instrument rather than
# disabling the check.
ASTROMETRY_PIXEL_SCALE_MIN_ARCSEC=0.05
ASTROMETRY_PIXEL_SCALE_MAX_ARCSEC=60.0

# Wider cone radius (arcsec) for moving-object detection.
# Widened from 30" to 120": fast-moving objects like Vesta travel
# ~60"/hour, so 30" was too tight to reliably catch cross-frame
# position shifts (must match the default in config.py).
MOVING_CONE_ARCSEC=120.0

# How far a real moving object can travel per minute, in arcsec — used to
# EXTEND the fixed cone above for a recent previous frame, so an object that
# moved more than MOVING_CONE_ARCSEC between two frames can still be paired
# with its own previous position. 20-30"/min is the fast-NEO regime; anything
# faster trails within one exposure and is caught by elongation alone.
MOVING_RATE_ARCSEC_PER_MIN=30.0

# Hard ceiling on that extended radius, whatever the elapsed time works out to
MOVING_CONE_MAX_ARCSEC=600.0

# Only a previous frame this recent (minutes) extends the cone at all
MOVING_EXTEND_MAX_GAP_MIN=30.0

# Magnitude delta that triggers a variability alert
DELTA_MAG_ALERT=0.5

# Statistical (catalog-independent) variability detection.
# A source whose own same-filter light curve has at least this many epochs,
# and whose current magnitude departs from that baseline by more than
# VARIABILITY_SIGMA times the baseline's own robust scatter, is reported as
# a VARIABLE_STAR candidate even when no catalog classifies it as variable.
# DELTA_MAG_ALERT above still applies on top as an absolute floor.
VARIABILITY_MIN_EPOCHS=3
VARIABILITY_SIGMA=3.0

# Faintest predicted V-mag for an MPC/SkyBot object to be matched.
# Objects fainter than this are below the typical detection threshold and
# would only match to unrelated background stars. Set to your telescope's
# approximate limiting magnitude for the typical exposure time.
MPC_MAG_LIMIT=19.0

# ------------------------------------------------------------
# Edge-of-frame geometry (astrometry.py + subtraction.py + anomaly_detector.py)
# ------------------------------------------------------------

# Fraction of NAXIS1/NAXIS2 treated as "near the edge" — coma and other
# off-axis aberrations stretch a star's PSF toward the edges/corners of a
# wide-field frame, inflating its measured elongation for purely optical
# reasons. No universal default fits every telescope/corrector combination;
# tune to how far coma actually reaches into your own frames.
EDGE_MARGIN_FRAC=0.05

# Elongation threshold for the "single-exposure trail" SPACE_DEBRIS shortcut
# in anomaly_detector.py (an unmatched source with no history at its current
# position needs no further evidence beyond this).
SPACE_DEBRIS_ELONGATION_MIN=3.0

# Same shortcut, but for a source flagged _near_edge — a substantially
# higher bar, since coma alone can already push an ordinary star's
# elongation past SPACE_DEBRIS_ELONGATION_MIN near the edge of a wide-field
# frame (see docs/ISSUES.md #4).
SPACE_DEBRIS_EDGE_ELONGATION_MIN=6.0

# ------------------------------------------------------------
# Image subtraction (modules/subtraction.py)
# ------------------------------------------------------------

# Minimum number of archived reference frames of the same object required
# to attempt subtraction. Fewer than this and it is skipped gracefully
# (e.g. the first observations of a new target).
SUBTRACTION_MIN_FRAMES=3

# Detection threshold on the difference image, in multiples of the
# background RMS.
SUBTRACTION_DETECT_SIGMA=5.0

# A reference frame captured at a different camera/rotator orientation than
# the new frame (e.g. a meridian flip) is coarse-pre-rotated by the known
# WCS-derived angle before alignment. Below this many degrees of difference,
# the rotation is skipped — astroalign's own registration already absorbs a
# small residual angle on its own.
SUBTRACTION_PREROTATE_MIN_DEG=2.0

# Worst reference seeing worth stacking, as a multiple of the new frame's own
# measured FWHM. Differencing a sharp frame against a blurred reference leaves
# a ring-shaped residual at every star — a mismatched PSF, not a transient.
# Frames whose QCFLAG says they failed QC are excluded outright. A frame
# carrying neither header (archived before they existed) is kept, and if
# screening would leave fewer than SUBTRACTION_MIN_FRAMES the unscreened set
# is used instead.
SUBTRACTION_REF_MAX_FWHM_RATIO=1.5

# Edge-zone diff candidates. Every candidate inside EDGE_MARGIN_FRAC used to
# be dropped, which also meant a genuine transient landing near the edge could
# never be found by subtraction at all. A coma residual is an elongated arc
# and usually weak; a round, strong residual is not that shape. Both bars are
# deliberately stricter than their whole-frame equivalents, because this is
# where the false positives concentrate.
SUBTRACTION_EDGE_ELONGATION_MAX=1.3
SUBTRACTION_EDGE_SNR_MIN=10.0

# An uncatalogued subtraction candidate within this many of its own FWHM of a
# catalogued star of about the same brightness (within
# SUBTRACTION_RESIDUAL_MAX_DMAG) is treated as that star's residual, not a
# transient. In FWHM, not arcseconds, so it holds across telescopes; never
# below MATCH_CONE_ARCSEC. A transient much fainter than a neighbour this
# close is suppressed too. 0 disables the check.
SUBTRACTION_RESIDUAL_RADIUS_FWHM=2.5
SUBTRACTION_RESIDUAL_MAX_DMAG=1.0

# Cap on the correlated-noise correction applied to a diff candidate's SNR.
# flux / (rms * sqrt(npix)) assumes each pixel's noise is independent, but
# astroalign's resampling (and the optional pre-rotation before it) spreads
# each input pixel's noise across several output pixels, so an aperture holds
# fewer independent measurements than pixels. The factor is measured from the
# frame's own difference image; this caps it. 1.0 disables the correction.
SUBTRACTION_NOISE_CORR_MAX=4.0

# ------------------------------------------------------------
# Photometry — sensor gain (modules/photometry.py, forced_photometry.py)
# ------------------------------------------------------------

# Sensor gain in ELECTRONS PER ADU, for the Poisson term of the aperture
# flux error. The aperture sum is in ADU, but photon shot noise is
# Poissonian in electrons, so the variance in ADU is flux_adu / gain.
#
# Leave BLANK to read it from each frame's own header. EGAIN is preferred
# over GAIN there: on most CMOS cameras EGAIN is the true e-/ADU conversion
# while GAIN is the camera's own gain SETTING in arbitrary vendor units
# (0-500 on a ZWO ASI, say). A header value outside the plausible e-/ADU
# range is rejected with a warning and 1.0 is used instead.
#
# Set this explicitly when your capture software writes no usable EGAIN and
# you know your sensor's real conversion factor.
PHOTOMETRY_GAIN_E_PER_ADU=

# Colour term in the Gaia zero-point. A star's instrumental magnitude in
# R/B/V/I differs from its Gaia broadband G magnitude by an amount that
# depends on the star's own colour, not by a constant — so a single median
# offset leaves a bias that drifts night to night with the reference set's
# colour mix. photometry.py calibrates with
#   catalog_mag - mag_instrumental = zero_point + k * (BP-RP - reference colour)
# using a FIXED k per filter (PHOTOMETRY_COLOR_TERMS) and fitting only the
# zero point per frame, so every epoch is transformed the same way. A filter
# with no configured k gets no colour term (the plain median offset).
PHOTOMETRY_COLOR_TERM_ENABLED=true

# Fixed colour term k per normalized filter, as FILTER:k pairs, e.g.
#   PHOTOMETRY_COLOR_TERMS=B:-1.0,G:-0.45,L:-0.40,R:-0.08
# Depends on the telescope/camera/filter — measure it: every calibrated frame
# logs "colour term measured on this frame k=..."; take each filter's median
# over a few nights. Empty = no colour term for any filter.
PHOTOMETRY_COLOR_TERMS=

# The three below only gate that per-frame DIAGNOSTIC fit.
# Minimum number of reference stars carrying a usable BP-RP colour before a
# slope is fitted at all
PHOTOMETRY_COLOR_TERM_MIN_REFS=10

# Minimum spread in BP-RP (mag) across those references — a slope fitted over
# a field whose stars all share one colour is unconstrained
PHOTOMETRY_COLOR_TERM_MIN_SPAN=0.5

# Largest |k| (mag/mag) considered physically plausible; a fit beyond this is
# discarded in favour of the plain constant offset
PHOTOMETRY_COLOR_TERM_MAX=1.5

# Largest Gaia RUWE (astrometric goodness of fit) a star may have and still
# anchor the zero point. Above it the star is usually an unresolved binary or
# a blend. Stars Gaia flags as variable or duplicated_source are excluded
# unconditionally. If screening would leave fewer than 3 references, the
# unscreened set is used instead and the fallback is logged.
PHOTOMETRY_REF_MAX_RUWE=1.4

# Sigma-clipping threshold for the per-source sky annulus. Without it a
# neighbouring star, a cosmic ray, or a host galaxy's own light inside the
# ring biases the sky median and is subtracted straight out of the source's
# flux — worst exactly in dense fields and near galaxies.
PHOTOMETRY_SKY_SIGMA_CLIP=3.0

# Minimum significance (flux / flux_err) for a magnitude to be calibrated.
# Below it the aperture measurement is still reported — flux, flux_err, snr
# and mag_instrumental are real — but mag_calibrated stays None, so no
# brightness-change branch can fire on a number that wanders past
# DELTA_MAG_ALERT on noise alone. Matches FORCED_PHOTOMETRY_MIN_SNR.
PHOTOMETRY_MIN_SNR=3.0

# How close (in units of the frame's own FWHM) another catalog entry may be
# before a forced measurement is considered blended and skipped. Two stars
# within a couple of FWHM share most of their light, so the measurement is
# really the pair's combined flux — and the wire schema has no field to say
# so. 0 disables the check.
FORCED_PHOTOMETRY_BLEND_FWHM=2.0

# ------------------------------------------------------------
# Forced photometry / reverse matching (modules/forced_photometry.py)
# A second, independent pass: for every Gaia DR3 star / MPC object in this
# frame's footprint with no corresponding entry in `sources`, measures the
# flux at its predicted pixel position anyway instead of treating it as
# "not detected". See modules/forced_photometry.py for the full rationale.
# ------------------------------------------------------------

# Set false to disable this pass entirely.
FORCED_PHOTOMETRY_ENABLED=true

# Faintest Gaia DR3 G-band magnitude eligible for forced photometry. No
# universal default fits every telescope/exposure combination — set this a
# couple of magnitudes above your own setup's typical detection limit for a
# representative exposure time. Not applied to MPC/SkyBot objects (already
# filtered by MPC_MAG_LIMIT below before they reach this module).
FORCED_PHOTOMETRY_MAG_LIMIT=20.0

# Minimum significance (net_flux / flux_err) for a forced measurement to be
# reported at all. Below this it's a genuine non-detection and is silently
# dropped, never reported as an "upper limit" magnitude.
FORCED_PHOTOMETRY_MIN_SNR=3.0

# A forced recovery whose calibrated magnitude disagrees with the star's own
# Gaia G by more than this measured something else (a galaxy, a neighbour's
# wing) and is dropped. Well-measured stars scatter ~0.3 mag about G. 0 disables.
FORCED_PHOTOMETRY_MAX_CATALOG_DEVIATION_MAG=1.5

# ------------------------------------------------------------
# Finder charts (modules/finder_chart.py)
# For every anomaly with a resolved source_id, builds a small PNG showing
# every frame that source has been detected on (position circled on each)
# and uploads it to the API. Fully regenerated on every new epoch.
# ------------------------------------------------------------

# Set to false to disable chart generation entirely (it adds a local render
# step plus two extra API round-trips per alerting-anomaly source).
CHART_ENABLED=true

# Half-width of the per-epoch crop for stationary anomalies (the
# "stamp_strip" style), in arcseconds.
CHART_STAMP_SIZE_ARCSEC=60.0

# Cap on the number of epochs drawn on one chart (oldest dropped first) —
# keeps image size and local FITS I/O bounded for long-running sources.
CHART_MAX_EPOCHS=12

# When a source's chart is "track" or "stamp_strip" (2+ epochs), also render
# and upload an animated GIF alongside the static PNG ("track_gif" /
# "stamp_strip_gif"). Set false to keep generating only the static PNGs.
CHART_GIF_ENABLED=true

# Per-frame display duration of the animated GIF, in milliseconds.
CHART_GIF_FRAME_DURATION_MS=700

# An epoch captured at a different camera/rotator orientation than the
# chart's own reference epoch (e.g. a meridian flip) is coarse-pre-rotated
# toward it before its crop is drawn (stamp_strip/stamp_strip_gif/track_gif).
# Below this many degrees of difference, the rotation is skipped.
CHART_PREROTATE_MIN_DEG=2.0

# ------------------------------------------------------------
# Observatory site coordinates
# Used for topocentric ephemeris queries to JPL Horizons.
# Latitude / longitude in decimal degrees; elevation in metres.
# ------------------------------------------------------------
SITE_LAT=0.0
SITE_LON=0.0
SITE_ELEV=0

# Budget for one JPL Horizons ephemeris lookup, in seconds. Applied twice:
# as astroquery's own HTTP timeout, so an unresponsive Horizons ends the
# worker thread instead of leaving it parked on asyncio's shared executor,
# and as the outer wall-clock ceiling on the call. On timeout the anomaly is
# kept without its ephemeris rather than the frame stalling.
EPHEMERIS_TIMEOUT_SEC=30

# ------------------------------------------------------------
# Normalization settings
# ------------------------------------------------------------

# Enable/disable automatic normalization of FITS header values and filenames.
# When enabled (default), normalizes:
#   - Object names: "M 51" → "M51", "NGC 1234" → "NGC1234"
#   - Filter names: "Blue" → "B", "Luminance" → "L", "H-Alpha" → "Ha"
#   - Frame types: "Light Frame" → "Light", "Dark Frame" → "Dark"
#   - Filenames: renamed to standard format {Object}_{Type}_{Filter}_{Exp}_{DateTime}.fits
# This ensures consistency across different capture software.
NORMALIZE_ENABLED=true

# ------------------------------------------------------------
# Catalog query cache (modules/catalog_matcher.py)
# ------------------------------------------------------------

# On-disk directory for cached Gaia/Simbad/2MASS/Pan-STARRS/MPC query
# results, keyed by catalog + sky tile. Must match a volume mount in
# docker-compose.yml pointing at a path OUTSIDE the container, so the cache
# survives a container restart (frequent during testing) instead of being
# thrown away with the container's writable layer.
CATALOG_CACHE_DIR=/cache/catalog

# How long a cached catalog query result stays valid, in hours.
CACHE_TTL_HOURS=1.0

# ------------------------------------------------------------
# Watcher batching (watcher.py)
# ------------------------------------------------------------

# Quiet period (seconds) after the most recently arrived FITS file before
# submitting everything buffered so far as one ANALYZE task. Re-armed on
# every new arrival, so a burst of files (a bulk import) becomes one task
# instead of one per file.
WATCHER_DEBOUNCE_SEC=5.0

# Flush the pending batch immediately once it reaches this many files,
# instead of waiting out the full debounce window — bounds how large a
# single ANALYZE task can grow during a large bulk import.
WATCHER_MAX_BATCH_SIZE=200

# Watch FITS_INCOMING via watchdog's PollingObserver (periodic directory
# listing/diff) instead of the platform-native, inotify-based Observer. Set
# this to true on Docker Desktop for macOS — FITS_INCOMING is a bind-mounted
# host directory there, and host-side changes don't reliably generate inotify
# events inside the Linux container (most visible for a bulk directory copy).
# Leave false on the real observatory server (Linux, local disk).
WATCHER_USE_POLLING_OBSERVER=false

# How often PollingObserver re-lists FITS_INCOMING, in seconds. Only used
# when WATCHER_USE_POLLING_OBSERVER=true.
WATCHER_POLLING_INTERVAL_SEC=2.0

# ------------------------------------------------------------
# Task queue worker (worker.py)
# ------------------------------------------------------------

# How often the worker polls GET /tasks?status=PENDING when idle, in seconds.
TASK_POLL_INTERVAL_SEC=10.0

# Idle polling backs off exponentially up to this ceiling (seconds), then
# holds steady; resets the moment a task is found. Keeps the API quiet
# during long idle stretches without ever leaving a new task unnoticed for
# too long.
TASK_POLL_BACKOFF_MAX_SEC=60.0

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Logging verbosity: DEBUG (verbose) or INFO (normal operation)
LOG_LEVEL=INFO
